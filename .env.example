# Copy this file to .env and fill in your own values. Never commit .env.

# ---- Database (local). Online, set DATABASE_URL instead of these five. ----
DB_HOST=localhost
DB_PORT=put_your_db_port_here
DB_NAME=put_your_db_name_here
DB_USER=put_your_db_user_here
DB_PASSWORD=put_your_db_password_here
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Staff log in with their own accounts (no shared admin key any more).
# Make the first owner with:  python tools/create_staff.py
# Optional: a password for the whole site (keeps the prototype private). /health stays open.
# SITE_PASSWORD=

# ---- Polygon Amoy TEST network (ledger anchoring and title records). Test wallet only. ----
ANCHOR_PRIVATE_KEY=put_your_anchor_private_key_here
POLYGON_RPC=https://polygon-amoy.drpc.org
# Address printed by: python tools/deploy_contract.py
# TITLE_CONTRACT=0x...

# ---- The site's public address, used in QR codes and payment return links ----
# PUBLIC_URL=https://your-site.onrender.com

# ---- Online payment with Paystack. Use the TEST secret key (sk_test_...). ----
# A live key (sk_live_...) is refused unless PAYSTACK_LIVE=1 is also set.
# PAYSTACK_SECRET_KEY=sk_test_...
# PAYSTACK_LIVE=

# ---- Optional tuning ----
# PRICE_INDIVIDUAL=15000
# PRICE_CORPORATE=200000
# OVERLAP_TOLERANCE_CM=10
